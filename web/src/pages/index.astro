---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NerdPanel from "../components/NerdPanel.astro";

const button =
  "h-10 rounded-md px-5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-400";
---

<Layout title="rubikfhe" description="A Rubik's cube solved under fully homomorphic encryption.">
  <Header />
  <main class="flex flex-1 flex-col items-center px-4 pb-4">
    <div id="cube" class="aspect-square w-full max-w-[min(42rem,calc(100dvh-14rem))] cursor-grab select-none"></div>
    <div class="mt-2 flex gap-3">
      <button
        id="scramble"
        type="button"
        class={`${button} bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300`}
      >
        Scramble
      </button>
      <button
        id="solve"
        type="button"
        class={`${button} bg-emerald-600 text-white hover:bg-emerald-500 disabled:cursor-not-allowed disabled:opacity-50`}
      >
        Solve
      </button>
      <button
        id="reset"
        type="button"
        class={`${button} border border-zinc-300 text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-900`}
      >
        Reset
      </button>
    </div>
    <p id="status" class="mt-3 h-4 font-mono text-xs text-zinc-500" aria-live="polite"></p>
    <div
      id="progress"
      class="mt-2 h-1.5 w-64 max-w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"
      role="progressbar"
      aria-label="Solve progress"
      aria-valuemin="0"
      aria-valuemax="100"
      hidden
    >
      <div id="progress-bar" class="h-full w-0 rounded-full bg-emerald-500 transition-[width] duration-300"></div>
    </div>
    <p id="solution" class="mt-2 min-h-4 max-w-xl text-center font-mono text-xs leading-relaxed"></p>
    <p class="mt-2 hidden text-center text-xs text-zinc-400 sm:block dark:text-zinc-600">
      drag a face to turn it · drag around the cube to rotate the view · keys{" "}
      <kbd class="font-mono">U R F D L B M E S</kbd>, hold <kbd class="font-mono">shift</kbd> for counter-clockwise
    </p>
  </main>
  <Footer />
  <NerdPanel />
</Layout>

<script>
  import "../scripts/app";
</script>
